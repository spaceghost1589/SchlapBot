{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-Ninja",
            "description": "Base Ninja inheritance which all other build are based on",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "warnings": {
                "dev": false
            },
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23"
            }
        },
        {
            "name": "base-windows-msvc",
            "description": "Base Window's MSVC inheritance which all other Windows builds are based on",
            "hidden": true,
            "inherits": "base-Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-RelWithDebInfo",
            "inherits": "base-windows-msvc",
            "displayName": "RelWithDebInfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "x64-Release",
            "inherits": "base-windows-msvc",
            "displayName": "Release",
            "cacheVariables": {
              "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-Debug",
            "inherits": "base-windows-msvc",
            "displayName": "Debug",
            "cacheVariables": {
              "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
